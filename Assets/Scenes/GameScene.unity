  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>J\xEDt pracovat</b>\r\n\r\nPot\xE9, co dos\xE1hne\u0161 z\xE1kladn\xEDho
    vzd\u011Bl\xE1n\xED, m\u016F\u017Ee\u0161 se p\u0159edt\xEDm, ne\u017E hod\xED\u0161
    kostkami rozhodnout, jestli pude tv\xE1 figurka pracovat. Ka\u017Ed\xFD hr\xE1\u010D
    m\u016F\u017Ee m\xEDt pouze jednu figurku v podnik\xE1n\xED a jednu figurku ve
    zam\u011Bstn\xE1n\xED. Tv\xE1 figurka v podnik\xE1n\xED nebo zam\u011Bstn\xE1n\xED
    se m\u016F\u017Ee kdykoli vr\xE1tit studovat, ale to j\xED stoj\xED jeden tah.\r\n"
  m_isRightToLeft: 0
