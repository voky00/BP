  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>F\xE1ze studia</b>\r\n\r\nKa\u017Ed\xFD tah za\u010D\xEDn\xE1 t\xEDm,
    \u017Ee hod\xED\u0161 kostkami. Ve f\xE1zi studia m\xE1\u0161 t\u0159i kostky.
    Pot\xE9, co hod\xED\u0161 kostky, si vybere\u0161, s jakou kostkou chce\u0161
    hr\xE1t. Tah nekon\u010D\xED, dokud nepou\u017Eije\u0161 v\u0161echny kostky.
    Ve f\xE1zi studia se sna\u017E\xED\u0161 dos\xE1hnout co nejvy\u0161\u0161\xEDho
    vzd\u011Bl\xE1n\xED, ale mus\xED\u0161 postupovat postupn\u011B. Sna\u017E se
    zahr\xE1t kostky tak, aby sis v jednom tahu z\xEDskal co nejv\xEDce vzd\u011Bl\xE1n\xED.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a3eddeefc040d8849a0d65831067d9b3, type: 2}
